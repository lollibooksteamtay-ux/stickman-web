[Unit]
Description=Stickman worker (hàng đợi dựng video B1-B5)
After=network.target

[Service]
Type=simple
User=stickman
WorkingDirectory=/opt/stickman/web
EnvironmentFile=/opt/stickman/web/.env
Environment=PATH=/root/.nvm/versions/node/v22.22.2/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/root/.nvm/versions/node/v22.22.2/bin/node worker/worker.js
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
